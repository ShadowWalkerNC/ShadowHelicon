# So are the shipped brand images: desktop icons, web favicons, social assets.
!apps/vscode/media/*.png
!apps/desktop/src-tauri/icons/**/*.png
!apps/web/public/*.png
!assets/social/*.png
!assets/social/**/*.png
!landing/**/*.png

